OPENAI_API_KEY=sk-your-key-here
PORT=3000

# Postgres connection string. Without this, orders are kept in memory and lost
# on every restart. Render, Neon and Supabase all hand you a URL in this shape:
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Password for viewing orders at /orders?key=...
ADMIN_KEY=pick-a-long-random-string

# What the charge is called on the customer's card statement. Stripe appends
# this to the account's own descriptor prefix, and the two together must fit
# 22 characters - shorten this if Stripe starts refusing checkout sessions.
STATEMENT_DESCRIPTOR_SUFFIX=STORYBOOKYOU

# --- the watchdog ---
# Where alerts go. A Gmail address: crayonauts.com mail is not what you want to
# depend on for the email that tells you mail is broken. Unset means alerts are
# logged and not sent.
ALERT_EMAIL=you@gmail.com
# Minutes between checks.
WATCHDOG_MINUTES=5
# The Render plan's RAM, for the memory warning. 2 GB by default.
INSTANCE_MEMORY_BYTES=2147483648
# Storage. Two different numbers get called "database size" and they are NOT
# comparable, so each has its own ceiling and the watchdog says which it read.
#
#   Neon's synthetic size = logical data on every branch + retained WAL.
#   This is what the plan caps, so prefer it.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_STORAGE_LIMIT_BYTES=536870912     # 0.5 GB, the free plan's limit
#
#   pg_database_size = the physical size of ONE database. It omits WAL, history
#   and other branches, so it reads LOWER than Neon's figure - pointing a Neon
#   plan limit at it means the warning arrives late or never. Only use this if
#   Neon's API is not configured, and calibrate it against the number /health
#   reports rather than guessing.
PG_CEILING_BYTES=
#
# Warn at 70% of whichever ceiling is in play, critical at 85%. Neither set
# means no storage warning at all, which beats measuring against a wrong number.
